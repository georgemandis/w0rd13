# Copy to .env. Everything here is optional.

# Plausible analytics script id (the part of the script URL after /js/ and before .js).
# Inlined into the client at build time; leave unset to run without analytics.
PLAUSIBLE_SCRIPT_ID=

# Only for the Orbit prototype scripts under proto/orbit (Workers AI embeddings).
CF_ACCOUNT_ID=
CF_TOKEN=
